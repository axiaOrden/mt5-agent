# Copy to .env and fill in values. Never commit .env.

# Provider used by the native Linux application:
#   "mt5"    - direct local MT5 integration (Windows only)
#   "mock"   - synthetic data for development/testing without a terminal
#   "remote" - read-only HTTP bridge to a Wine-hosted MT5 terminal
PROVIDER=remote

# Local read-only MT5 bridge (used when PROVIDER=remote)
MT5_REMOTE_URL=http://127.0.0.1:8765
# Per-request timeout in seconds (first-time history downloads can be slow)
MT5_REMOTE_TIMEOUT=30

# Wine environment (used by scripts/start-mt5-bridge.sh)
WINE_BINARY=/usr/bin/wine
WINE_PREFIX=/home/heaxia/.wine
WINE_PYTHON=/home/heaxia/.wine/drive_c/users/heaxia/AppData/Local/Programs/Python/Python312/python.exe

# MetaTrader 5 terminal
MT5_TERMINAL_LINUX=/home/heaxia/App/exe/fx/mt5/terminal64.exe
MT5_TERMINAL_WINDOWS=Z:\home\heaxia\App\exe\fx\mt5\terminal64.exe

# Bridge bind address (must stay on localhost; never 0.0.0.0)
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765

# Optional path to the MetaTrader 5 terminal executable (Windows) for the
# direct "mt5" provider. Leave empty to use the default installation path.
MT5_TERMINAL_PATH=

# Account credentials. Only used by the local MT5 integration where supported.
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

# Data / log locations (defaults to ./data and ./logs relative to project root).
# DATA_DIR=
# LOG_DIR=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
