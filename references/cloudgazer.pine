//************//
// Psy Levels //
//************//




int previousSunday = dayofmonth - dayofweek + 1
bool nyDST = false
bool ukDST = false
bool sydDST = false

if month < 3 or month > 11
    nyDST := false
    ukDST := false
    sydDST := true
else if month > 4 and month < 10
    nyDST := true
    ukDST := true
    sydDST := false
else if month == 3
    nyDST := previousSunday >= 8
    ukDST := previousSunday >= 24
    sydDST := true
else if month == 4
    nyDST := true
    ukDST := true
    sydDST := previousSunday <= 0
else if month == 10
    nyDST := true
    ukDST := previousSunday <= 24
    sydDST := previousSunday >= 0
else // month == 11
    nyDST := previousSunday <= 0
    ukDST := false
    sydDST := true
    

var int oneWeekMillis = (7 * 24 * 60 * 60 * 1000)

// Timestamp any of the 6 previous days in the week (such as last Wednesday at 21 hours GMT)
timestampPreviousDayOfWeek(previousDayOfWeek, hourOfDay, GMTOffset) =>
    int dayofweekOffset = na
    int previousDayOfMonth = na
    int psySessionStartTime = na
    int returnValue = na
    //today we onlu care about Monday - forec and Saturday for crypto - if that changes in the future this code will need to be updated
    if previousDayOfWeek == "Monday"
        dayofweekOffset := (dayofweek(time, GMTOffset) - 1 + 6) % 7
    
    if previousDayOfWeek == "Saturday"
        dayofweekOffset := (dayofweek(time, GMTOffset) - 1 + 1) % 7


    previousDayOfMonth := dayofmonth(time, GMTOffset) - dayofweekOffset
    
    //based on time we are on the day where the psy levels will change - now we need to determine if we are before or after the 
    //time when the psy levels will chnge
    
    //today is Saturday or Monday dayofweekOffset will be equal to zero and we are checking if the current time is before the psy level change
    //we also need to be minful of GMTOffset. using  and hourOfDay != 00 because if we switch at midnight we dont have to do anything
    if dayofweekOffset == 0 and GMTOffset == "GMT" and hourOfDay >= hour(time,GMTOffset) and hourOfDay != 00
        //even thou today is saturday we are still not past the change time - subract a week because it is not time to change yet
        returnValue := timestamp(GMTOffset, year, month, previousDayOfMonth, hourOfDay, 00, 00) - oneWeekMillis
    //same as previous but handling GMT+1
    else if dayofweekOffset == 0 and GMTOffset == "GMT+1" and hourOfDay -1 >= hour(time,GMTOffset) //and 0 != minute(time,GMTOffset)
        returnValue := timestamp(GMTOffset, year, month, previousDayOfMonth, hourOfDay, 00, 00) - oneWeekMillis
    //default - we have already switched some time ago
    else
        returnValue := timestamp(GMTOffset, year, month, previousDayOfMonth, hourOfDay, 00, 00)
    returnValue



int psySession = na 
int psySessionStartDay = na
int psySessionStartTime = na
bool inPsySession = false
float psyHi = na
float psyLo = na
string psyHiLabel = na
string psyLoLabel = na
//only do the calc if the user has not disabled the psy levels



if psyType == 'crypto'
    if sydDST
        psySession := time('240', '2200-0600:1', "GMT+1")
        psySessionStartTime := timestampPreviousDayOfWeek('Saturday', 22, 'GMT+1')
    else
        psySession := time('240', '2200-0600:1', "GMT")
        psySessionStartTime := timestampPreviousDayOfWeek('Saturday', 22, 'GMT')
else
    psySession := time('240', '0000-0800:2', "GMT")
    psySessionStartTime := timestampPreviousDayOfWeek('Monday', 00, 'GMT')
        
inPsySession := na(psySession) ? false : true
if inPsySession
    // When entering a new psy session, initialize hi/lo
    if not inPsySession[1]
        psyHi := high
        psyLo := low
        psyHiLabel := 'Psy-Hi calculating...'
        psyLoLabel := 'Psy-Lo calculating...'
    // After initialization, calculate psy hi/lo
    else
        psyHi := math.max(high, psyHi[1])
        psyLo := math.min(low, psyLo[1])
        //stylePsy := line.style_dashed //this does not work for style correctly but it does for the label which is odd
        psyHiLabel := 'Psy-Hi calculating...'
        psyLoLabel := 'Psy-Lo calculating...'
    // When not in the psy session, use the last value of psyHi and psyLo
else
    psyHi := psyHi[1]
    psyLo := psyLo[1]
    psyHiLabel := 'Psy-Hi'
    psyLoLabel := 'Psy-Lo'




// === Check if price is inside range
inRange = close <= psyHi and close >= psyLo
belowRange = close < psyLo
aboveRange = close > psyHi
float fibBaseLow  = na
float fibBaseHigh = na

// === Assign FIRST
if inRange
    fibBaseLow  := psyLo
    fibBaseHigh := psyHi

else if belowRange
    fibBaseLow  := today_low
    fibBaseHigh := psyLo

else if aboveRange
    fibBaseLow  := psyHi
    fibBaseHigh := today_high

// === THEN calculate
fibRange = fibBaseHigh - fibBaseLow

fib_618 = fibBaseLow + fibRange * 0.618
fib_50  = fibBaseLow + fibRange * 0.5


var line psyfib618 = na
var line psyfib50  = na

// === VALIDATION
validFib =
     not na(fibBaseLow) and
     not na(fibBaseHigh) and
     fibBaseHigh != fibBaseLow

// Draw Psy Level Lines
if (barstate.islast) and not showallPsy and show_psylevels
    
    psyHiLine = line.new(time, psyHi, psySessionStartTime, psyHi, xloc.bar_time, extend.none, psycolH)
    line.delete(psyHiLine[1])
    
    psyLoLine = line.new(time, psyLo, psySessionStartTime, psyLo, xloc.bar_time, extend.none, psycolL)
    line.delete(psyLoLine[1])

    // === Define colors properly
    fibColor618 = (
         inRange     ? color.orange :
         belowRange  ? color.red :
         aboveRange  ? color.lime :
         color.gray )

    fibColor50 = (
         inRange     ? color.yellow :
         belowRange  ? color.maroon :
         aboveRange  ? color.green :
         color.gray)

    if validFib and barstate.islast
        line.delete(psyfib618)
        line.delete(psyfib50)

        psyfib618 := line.new(time, fib_618, psySessionStartTime, fib_618, xloc.bar_time, extend.none, color=fibColor618)
        psyfib50  := line.new(time, fib_50,  psySessionStartTime, fib_50,  xloc.bar_time, extend.none, color=fibColor50)

// Write Psy Level Labels - same label regardless if line.new or plot used
r_label(psyHi, psyHiLabel, label.style_none, psycolH, show_psylabel)
r_label(psyLo, psyLoLabel, label.style_none, psycolL, show_psylabel) 

// Plot Historical Psy Level
plot(showPsy and show_psylevels and showallPsy ? psyHi : na, color=psycolH, style=plot.style_stepline, linewidth=2, editable=false, title="Psy-Hi")  //, offset=psy_plot_offset)
plot(showPsy and show_psylevels and showallPsy ? psyLo : na, color=psycolL, style=plot.style_stepline, linewidth=2, editable=false, title="Psy-Lo")  //, offset=psy_plot_offset)


//────────────────────
// TREND SCOUTER CHANNEL ENGINE
//────────────────────
bool useTrendSource = trendCoords == "Source"
float trendHighSource = useTrendSource ? trendSource : high
float trendLowSource = useTrendSource ? trendSource : low

var array<float> shortTrendBag = array.new_float()
var array<float> longTrendBag = array.new_float()
var int shortTrendDirection = 0
var int longTrendDirection = 0

float shortHighCoord = ta.highestbars(trendHighSource, shortTrendLength) == 0 ? trendHighSource : na
float shortLowCoord = ta.lowestbars(trendLowSource, shortTrendLength) == 0 ? trendLowSource : na
float longHighCoord = ta.highestbars(trendHighSource, longTrendLength) == 0 ? trendHighSource : na
float longLowCoord = ta.lowestbars(trendLowSource, longTrendLength) == 0 ? trendLowSource : na

bool newShortHigh = not na(shortHighCoord) and na(shortLowCoord)
bool newShortLow = not na(shortLowCoord) and na(shortHighCoord)
bool newLongHigh = not na(longHighCoord) and na(longLowCoord)
bool newLongLow = not na(longLowCoord) and na(longHighCoord)

shortTrendDirection := newShortHigh ? 1 : newShortLow ? -1 : shortTrendDirection
longTrendDirection := newLongHigh ? 1 : newLongLow ? -1 : longTrendDirection

bool shortDirectionChanged = not na(shortTrendDirection[1]) and shortTrendDirection != shortTrendDirection[1]
bool longDirectionChanged = not na(longTrendDirection[1]) and longTrendDirection != longTrendDirection[1]
float activeShortCoord = shortTrendDirection == 1 ? shortHighCoord : shortLowCoord
float activeLongCoord = longTrendDirection == 1 ? longHighCoord : longLowCoord

if shortDirectionChanged and not na(activeShortCoord)
    addTrendPoint(shortTrendBag, activeShortCoord, time, trendSource)
else
    updateTrendPoint(shortTrendBag, activeShortCoord, time, trendSource, shortTrendDirection)

if longDirectionChanged and not na(activeLongCoord)
    addTrendPoint(longTrendBag, activeLongCoord, time, trendSource)
else
    updateTrendPoint(longTrendBag, activeLongCoord, time, trendSource, longTrendDirection)

[shortTopFromX, shortTopFromY] = getTrendCoord(shortTrendBag, "top", shortTrendFrom, useTrendSource)
[shortTopToX, shortTopToY] = getTrendCoord(shortTrendBag, "top", shortTrendTo, useTrendSource)
[shortBottomFromX, shortBottomFromY] = getTrendCoord(shortTrendBag, "bottom", shortTrendFrom, useTrendSource)
[shortBottomToX, shortBottomToY] = getTrendCoord(shortTrendBag, "bottom", shortTrendTo, useTrendSource)
[longTopFromX, longTopFromY] = getTrendCoord(longTrendBag, "top", longTrendFrom, useTrendSource)
[longTopToX, longTopToY] = getTrendCoord(longTrendBag, "top", longTrendTo, useTrendSource)
[longBottomFromX, longBottomFromY] = getTrendCoord(longTrendBag, "bottom", longTrendFrom, useTrendSource)
[longBottomToX, longBottomToY] = getTrendCoord(longTrendBag, "bottom", longTrendTo, useTrendSource)

float shortMidFrom = (shortTopFromY + shortBottomFromY) / 2.0
float shortMidTo = (shortTopToY + shortBottomToY) / 2.0
float longMidFrom = (longTopFromY + longBottomFromY) / 2.0
float longMidTo = (longTopToY + longBottomToY) / 2.0
color shortChannelColor = shortMidTo > shortMidFrom ? shortTrendUpColor : shortTrendDownColor
color longChannelColor = longMidTo > longMidFrom ? longTrendUpColor : longTrendDownColor

int customTopFromX = na
float customTopFromY = na
int customTopToX = na
float customTopToY = na
int customBottomFromX = na
float customBottomFromY = na
int customBottomToX = na
float customBottomToY = na

if customTopFromGroup == "Long"
    [selectedX, selectedY] = getTrendCoord(longTrendBag, "top", customTopFromPair, useTrendSource)
    customTopFromX := selectedX
    customTopFromY := selectedY
else
    [selectedX, selectedY] = getTrendCoord(shortTrendBag, "top", customTopFromPair, useTrendSource)
    customTopFromX := selectedX
    customTopFromY := selectedY

if customTopToGroup == "Long"
    [selectedX, selectedY] = getTrendCoord(longTrendBag, "top", customTopToPair, useTrendSource)
    customTopToX := selectedX
    customTopToY := selectedY
else
    [selectedX, selectedY] = getTrendCoord(shortTrendBag, "top", customTopToPair, useTrendSource)
    customTopToX := selectedX
    customTopToY := selectedY

if customBottomFromGroup == "Long"
    [selectedX, selectedY] = getTrendCoord(longTrendBag, "bottom", customBottomFromPair, useTrendSource)
    customBottomFromX := selectedX
    customBottomFromY := selectedY
else
    [selectedX, selectedY] = getTrendCoord(shortTrendBag, "bottom", customBottomFromPair, useTrendSource)
    customBottomFromX := selectedX
    customBottomFromY := selectedY

if customBottomToGroup == "Long"
    [selectedX, selectedY] = getTrendCoord(longTrendBag, "bottom", customBottomToPair, useTrendSource)
    customBottomToX := selectedX
    customBottomToY := selectedY
else
    [selectedX, selectedY] = getTrendCoord(shortTrendBag, "bottom", customBottomToPair, useTrendSource)
    customBottomToX := selectedX
    customBottomToY := selectedY

color customTopColor = customTopToY > customTopFromY ? customTrendUpColor : customTrendDownColor
color customBottomColor = customBottomToY > customBottomFromY ? customTrendUpColor : customTrendDownColor

var line shortTopLine = na
var line shortBottomLine = na
var line longTopLine = na
var line longBottomLine = na
var line customTopLine = na
var line customBottomLine = na
var line shortTopExtension = na
var line shortBottomExtension = na
var line longTopExtension = na
var line longBottomExtension = na
var line customTopExtension = na
var line customBottomExtension = na

if barstate.islast
    line.delete(shortTopLine)
    line.delete(shortBottomLine)
    line.delete(longTopLine)
    line.delete(longBottomLine)
    line.delete(customTopLine)
    line.delete(customBottomLine)
    line.delete(shortTopExtension)
    line.delete(shortBottomExtension)
    line.delete(longTopExtension)
    line.delete(longBottomExtension)
    line.delete(customTopExtension)
    line.delete(customBottomExtension)

    shortTopLine := drawTrendLine(showShortTrend, shortTopFromX, shortTopFromY, shortTopToX, shortTopToY, false, shortChannelColor, shortTrendStyleInput, shortTrendWidth)
    shortBottomLine := drawTrendLine(showShortTrend, shortBottomFromX, shortBottomFromY, shortBottomToX, shortBottomToY, false, shortChannelColor, shortTrendStyleInput, shortTrendWidth)
    longTopLine := drawTrendLine(showLongTrend, longTopFromX, longTopFromY, longTopToX, longTopToY, false, longChannelColor, longTrendStyleInput, longTrendWidth)
    longBottomLine := drawTrendLine(showLongTrend, longBottomFromX, longBottomFromY, longBottomToX, longBottomToY, false, longChannelColor, longTrendStyleInput, longTrendWidth)
    customTopLine := drawTrendLine(showCustomTrendTop, customTopFromX, customTopFromY, customTopToX, customTopToY, false, customTopColor, customTrendStyleInput, customTrendWidth)
    customBottomLine := drawTrendLine(showCustomTrendBottom, customBottomFromX, customBottomFromY, customBottomToX, customBottomToY, false, customBottomColor, customTrendStyleInput, customTrendWidth)

    shortTopExtension := drawTrendLine(showShortTrend and shortTrendExtend, shortTopFromX, shortTopFromY, shortTopToX, shortTopToY, true, shortChannelColor, shortTrendExtensionStyleInput, shortTrendWidth)
    shortBottomExtension := drawTrendLine(showShortTrend and shortTrendExtend, shortBottomFromX, shortBottomFromY, shortBottomToX, shortBottomToY, true, shortChannelColor, shortTrendExtensionStyleInput, shortTrendWidth)
    longTopExtension := drawTrendLine(showLongTrend and longTrendExtend, longTopFromX, longTopFromY, longTopToX, longTopToY, true, longChannelColor, longTrendExtensionStyleInput, longTrendWidth)
    longBottomExtension := drawTrendLine(showLongTrend and longTrendExtend, longBottomFromX, longBottomFromY, longBottomToX, longBottomToY, true, longChannelColor, longTrendExtensionStyleInput, longTrendWidth)
    customTopExtension := drawTrendLine(showCustomTrendTop and customTrendExtend, customTopFromX, customTopFromY, customTopToX, customTopToY, true, customTopColor, customTrendExtensionStyleInput, customTrendWidth)
    customBottomExtension := drawTrendLine(showCustomTrendBottom and customTrendExtend, customBottomFromX, customBottomFromY, customBottomToX, customBottomToY, true, customBottomColor, customTrendExtensionStyleInput, customTrendWidth)

    
//────────────────────
// TREND CONTEXT (NON-SIGNAL)
//────────────────────
bullConfirmed = close > spanA and close > spanB
bearConfirmed = close < spanA and close < spanB

//────────────────────
// EVENTS (ONE-SHOT)
//────────────────────
crossUp   = ta.crossover(tenkan, kijun)
crossDown = ta.crossunder(tenkan, kijun)
vwapCrossUp = ta.crossover(close, hlcVwap)
vwapCrossDown = ta.crossunder(close, hlcVwap)



var Position pos = Position.FLAT
string labelText = ""

//────────────────────
// STATE TRANSITIONS
//────────────────────
// VWAP events take priority if VWAP and Ichimoku disagree on the same bar.
if vwapCrossUp
    if pos != Position.LONG
        labelText := "BUY"
        pos := Position.LONG

else if vwapCrossDown
    if pos != Position.SHORT
        labelText := "SELL"
        pos := Position.SHORT

else if crossUp
    if pos == Position.SHORT
        labelText := "BUY"
        pos := Position.LONG
    else if pos == Position.FLAT
        labelText := bullConfirmed ? "BUY" : "WB"
        pos := Position.LONG

else if crossDown
    if pos == Position.LONG
        labelText := "SELL"
        pos := Position.SHORT
    else if pos == Position.FLAT
        labelText := bearConfirmed ? "SELL" : "WS"
        pos := Position.SHORT
else
    labelText := ""



// === PRECOMPUTE (ALWAYS EXECUTES)
cross_618_up   = ta.crossover(close, fib_618)
cross_618_down = ta.crossunder(close, fib_618)

cross_50_up    = ta.crossover(close, fib_50)
cross_50_down  = ta.crossunder(close, fib_50)



// === SIGNALS
psy_rb = validFib and inRange and cross_618_up
psy_rs = validFib and inRange and cross_618_down
psy_gb = validFib and inRange and cross_50_up
psy_gs = validFib and inRange and cross_50_down

//────────────────────
// LABEL TEXT
//────────────────────
string psyLabelText = ""

if psy_rb
    psyLabelText := "RB"
else if psy_rs
    psyLabelText := "RS"
else if psy_gb
    psyLabelText := "GB"
else if psy_gs
    psyLabelText := "GS"

//────────────────────
// COLOR
//────────────────────
psyColor =
     psy_rb ? color.lime :
     psy_rs ? color.red  :
     psy_gb ? color.blue :
     psy_gs ? color.purple :
     na

//────────────────────
// POSITION
//────────────────────
psyY =
     psy_rb or psy_gb ? high + (high - low) * 0.2 :
     psy_rs or psy_gs ? low  - (high - low) * 0.2 :
     na

//────────────────────
// DRAW
//────────────────────
var int lastPsyBar = na
newPsySignal = psy_rb or psy_rs or psy_gb or psy_gs

if newPsySignal and barstate.isconfirmed and bar_index != lastPsyBar
    lastPsyBar := bar_index

    label.new(
        bar_index,
        psyY,
        "Psy " + psyLabelText,
        style = label.style_label_up,
        color = psyColor,
        textcolor = color.white,
        size = size.small
    )

//────────────────────
// DRAW LABEL (EVENT ONLY)
//────────────────────
if labelText != ""


    // --- send alert ---
    send_alert(
        syminfo.ticker,
        time,
        pos,
        labelText,
        open,
        close,
        high,
        low,
        volume,
        timeframe.period,
        hlcVwap
    )

    label.new(
        bar_index,
        labelText == "BUY" or labelText == "WB" ? low : high,
        labelText,
        style = label.style_diamond,
        size = size.small,
        color =
            labelText == "BUY"  ? color.new(color.green, 55) :
            labelText == "SELL" ? color.new(color.red,   55) :
            labelText == "WB"   ? color.new(color.lime,  65) :
            labelText == "WS"   ? color.new(color.orange,65) :
                                  color.gray,
        textcolor = color.white
    )


//────────────────────
// VECTOR CANDLE ZONES
//────────────────────
regularCandleUpColor = color.rgb(140, 161, 142)

var zoneBoxesAbove = array.new_box()
var zoneBoxesBelow = array.new_box()

if showVCZ

    pvsra = getPvsraFlagByColor(
         pvsraColor,
         redVectorColor,
         greenVectorColor,
         violetVectorColor,
         blueVectorColor,
         regularCandleUpColor
     )

    updateZones(
         pvsra,
         0,
         zoneBoxesBelow,
         zonesMax,
         high,
         low,
         open,
         close,
         transperancy,
         zoneUpdateType,
         zoneColor,
         zoneType,
         borderWidth,
         colorOverride,
         redVectorColor,
         greenVectorColor,
         violetVectorColor,
         blueVectorColor
     )

    updateZones(
         pvsra,
         1,
         zoneBoxesAbove,
         zonesMax,
         high,
         low,
         open,
         close,
         transperancy,
         zoneUpdateType,
         zoneColor,
         zoneType,
         borderWidth,
         colorOverride,
         redVectorColor,
         greenVectorColor,
         violetVectorColor,
         blueVectorColor
     )

    cleanarr(zoneBoxesAbove)
    cleanarr(zoneBoxesBelow)

