//────────────────────
// FUNCTIONS
//────────────────────
getDonchian(len, src) =>
    (ta.lowest(src, len) + ta.highest(src, len)) / 2.0

getLeadLine1(a, b) =>
    (a + b) / 2.0


// === Get OHLC from specific daily bar
getOHLC(tf, offset) =>
    o = request.security(syminfo.tickerid, tf, open[offset], lookahead = barmerge.lookahead_on)
    h = request.security(syminfo.tickerid, tf, high[offset], lookahead = barmerge.lookahead_on)
    l = request.security(syminfo.tickerid, tf, low[offset], lookahead = barmerge.lookahead_on)
    c = request.security(syminfo.tickerid, tf, close[offset], lookahead = barmerge.lookahead_on)
    [o,h, l, c]

// === Calculate Pivot from OHLC
calcPivot(o,h, l, c) =>
    pp = (h + l + c) / 3
    r1 = 2 * pp - l
    s1 = 2 * pp - h
    r2 = pp + (h - l)
    s2 = pp - (h - l)
    r3 = h + 2 * (pp - l)
    s3 = l - 2 * (h - pp)
    [pp, r1, s1, r2, s2, r3, s3]


label_x_offset = time_close + 5 * timeframe.multiplier * 60 * 1000


r_label(ry, rtext, rstyle, rcolor, valid) =>
    var label rLabel = na
    if valid and barstate.isrealtime
        rLabel := label.new(x=label_x_offset, y=ry, text=rtext, xloc=xloc.bar_time, style=rstyle, textcolor=rcolor, textalign=text.align_right)
        label.delete(rLabel[1])
    rLabel





//────────────────────
// VCZ FUNCTIONS
//────────────────────

getPvsraFlagByColor(
     pvsraColor,
     redVectorColor,
     greenVectorColor,
     violetVectorColor,
     blueVectorColor,
     lightGrayCandleColor
 ) =>

    if pvsraColor == greenVectorColor
        3
    else if pvsraColor == redVectorColor
        -3
    else if pvsraColor == blueVectorColor
        2
    else if pvsraColor == violetVectorColor
        -2
    else if pvsraColor == lightGrayCandleColor
        1
    else
        -1



cleanarr(arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            if na(array.get(arr, i))
                array.remove(arr, i)



updateZones(
     pvsra,
     direction,
     boxArr,
     maxlevels,
     pvsraHigh,
     pvsraLow,
     pvsraOpen,
     pvsraClose,
     transperancy,
     zoneupdatetype,
     zonecolor,
     zonetype,
     borderwidth,
     coloroverride,
     redVectorColor,
     greenVectorColor,
     violetVectorColor,
     blueVectorColor
 ) =>

    levelclose = pvsraClose[1]
    levelopen  = pvsraOpen[1]
    levelhigh  = pvsraHigh[1]
    levellow   = pvsraLow[1]

    length = array.size(boxArr)

    CUColorBG = color.new(greenVectorColor, transperancy)
    CDColorBG = color.new(redVectorColor, transperancy)
    AUColorBG = color.new(blueVectorColor, transperancy)
    ADColorBG = color.new(violetVectorColor, transperancy)

    bgColor =
         coloroverride ? zonecolor :
         pvsra == 2 ? AUColorBG :
         pvsra == -2 ? ADColorBG :
         pvsra == 3 ? CUColorBG :
         pvsra == -3 ? CDColorBG :
         na

    if (pvsra[1] < -1 or pvsra[1] > 1)

        top =
             levelclose > levelopen
             ? (zonetype == 'Body with wicks' ? levelhigh : levelclose)
             : (zonetype == 'Body with wicks' ? levelhigh : levelopen)

        bottom =
             levelclose > levelopen
             ? (zonetype == 'Body with wicks' ? levellow : levelopen)
             : (zonetype == 'Body with wicks' ? levellow : levelclose)

        array.unshift(
             boxArr,
             box.new(
                 left = bar_index[1],
                 top = top,
                 right = bar_index,
                 bottom = bottom,
                 extend = extend.right,
                 bgcolor = bgColor[1],
                 border_width = borderwidth,
                 border_color = color.rgb(255,255,255,80)
             )
         )

        length += 1

    if length > 0

        for i = 0 to length - 1

            valbox = array.get(boxArr, i)

            if not na(valbox)

                valbottom = box.get_bottom(valbox)
                valtop    = box.get_top(valbox)

                if direction == 1

                    if pvsraClose >= valtop or pvsraHigh >= valtop
                        box.delete(valbox)
                        array.set(boxArr, i, na)

                    else if pvsraHigh > valbottom and pvsraHigh < valtop
                        box.set_bottom(valbox, pvsraHigh)

                    else if pvsraClose > valbottom and pvsraClose < valtop
                        box.set_bottom(valbox, pvsraClose)

                else

                    if pvsraClose <= valbottom or pvsraLow <= valbottom
                        box.delete(valbox)
                        array.set(boxArr, i, na)

                    else if pvsraLow > valbottom and pvsraLow < valtop
                        box.set_top(valbox, pvsraLow)

                    else if pvsraClose > valbottom and pvsraClose < valtop
                        box.set_top(valbox, pvsraClose)

    if length > maxlevels

        val = array.get(boxArr, length - 1)

        if not na(val)
            box.delete(val)

        array.pop(boxArr)


//────────────────────
// TREND SCOUTER FUNCTIONS
// Each swing occupies three array slots: price, time and source price.
//────────────────────
addTrendPoint(array<float> bag, float value, int pointTime, float pointSource) =>
    array.unshift(bag, pointSource)
    array.unshift(bag, float(pointTime))
    array.unshift(bag, value)
    if array.size(bag) > 21
        array.pop(bag)
        array.pop(bag)
        array.pop(bag)
    0.0

updateTrendPoint(array<float> bag, float value, int pointTime, float pointSource, int direction) =>
    if array.size(bag) == 0
        addTrendPoint(bag, value, pointTime, pointSource)
    else if not na(value) and ((direction == 1 and value > array.get(bag, 0)) or (direction == -1 and value < array.get(bag, 0)))
        array.set(bag, 0, value)
        array.set(bag, 1, float(pointTime))
        array.set(bag, 2, pointSource)
    0.0

getTrendCoord(array<float> bag, string position, string selection, bool useSource) =>
    int firstOffset = selection == "Front" ? 0 : selection == "Mid" ? 6 : 12
    int secondOffset = firstOffset + 3
    float firstY = array.size(bag) > secondOffset + 2 ? array.get(bag, firstOffset + (useSource ? 2 : 0)) : na
    float secondY = array.size(bag) > secondOffset + 2 ? array.get(bag, secondOffset + (useSource ? 2 : 0)) : na
    int firstX = array.size(bag) > secondOffset + 2 ? int(math.round(array.get(bag, firstOffset + 1))) : na
    int secondX = array.size(bag) > secondOffset + 2 ? int(math.round(array.get(bag, secondOffset + 1))) : na
    bool selectFirst = position == "top" ? firstY >= secondY : firstY <= secondY
    [selectFirst ? firstX : secondX, selectFirst ? firstY : secondY]

getTrendLineStyle(string styleInput) =>
    styleInput == "Solid" ? line.style_solid : styleInput == "Dashed" ? line.style_dashed : line.style_dotted

drawTrendLine(bool visible, int x1, float y1, int x2, float y2, bool extendLine, color lineColor, string styleInput, int lineWidth) =>
    visible and not na(x1) and not na(y1) and not na(x2) and not na(y2) ? line.new(x1, y1, x2, y2, xloc = xloc.bar_time, extend = extendLine ? extend.right : extend.none, color = lineColor, style = getTrendLineStyle(styleInput), width = lineWidth) : na



//────────────────────
// POSITION STATE MACHINE
//────────────────────
enum Position
    FLAT
    LONG
    SHORT

get_candle_time_str(timestamp) =>
    yr = str.tostring(year(timestamp))
    mo = str.tostring(month(timestamp), '00')
    dy = str.tostring(dayofmonth(timestamp), '00')
    hr = str.tostring(hour(timestamp), '00')
    mn = str.tostring(minute(timestamp), '00')
    sc = str.tostring(second(timestamp), '00')
    yr + '-' + mo + '-' + dy + 'T' + hr + ':' + mn + ':' + sc + 'Z'


send_alert(
    _symbol,
    _candle_time,
    Position _deal_type,
    string _signal_type,
    _open,
    _close,
    _high,
    _low,
    _volume,
    _timeframe,
    _price
) =>
    candle_time_str = get_candle_time_str(_candle_time)

    chart_url = (
        "https://www.tradingview.com/chart/?" +
        "symbol=" + str.replace_all(syminfo.tickerid, ":", "%3A") +
        "&interval=" + timeframe.period
    )

    embedColor =
         _deal_type == Position.LONG ? 5763719 :
         _deal_type == Position.SHORT ? 15548997 :
         9807270

    directionIcon =
         _deal_type == Position.LONG ? "🟢📈" :
         _deal_type == Position.SHORT ? "🔴📉" :
         "⚪➡️"

    json_payload = (
        "{" +
        "\"content\":\"" + directionIcon + " **Cloudgazer Signal**\"," +
        "\"embeds\":[" +
        "{" +
        "\"title\":\"" + directionIcon + " " + _symbol + " - " + _signal_type + "\"," +
        "\"url\":\"" + chart_url + "\"," +
        "\"color\":" + str.tostring(embedColor) + "," +
        "\"fields\":[" +
        "{\"name\":\"Direction\",\"value\":\"" + directionIcon + " " + str.tostring(_deal_type) + "\",\"inline\":true}," +
        "{\"name\":\"Timeframe\",\"value\":\"" + _timeframe + "\",\"inline\":true}," +
        "{\"name\":\"Close\",\"value\":\"" + str.tostring(_close) + "\",\"inline\":true}," +
        "{\"name\":\"Open\",\"value\":\"" + str.tostring(_open) + "\",\"inline\":true}," +
        "{\"name\":\"High\",\"value\":\"" + str.tostring(_high) + "\",\"inline\":true}," +
        "{\"name\":\"Low\",\"value\":\"" + str.tostring(_low) + "\",\"inline\":true}," +
        "{\"name\":\"Volume\",\"value\":\"" + str.tostring(_volume) + "\",\"inline\":true}," +
        "{\"name\":\"VWAP\",\"value\":\"" + str.tostring(_price) + "\",\"inline\":true}," +
        "{\"name\":\"Candle Time\",\"value\":\"" + candle_time_str + "\",\"inline\":false}," +
        "{\"name\":\"Chart\",\"value\":\"" + chart_url + "\",\"inline\":false}" +
        "]" +
        "}" +
        "]," +
        "\"cloudgazer\":{" +
        "\"symbol\":\"" + _symbol + "\"," +
        "\"timeframe\":\"" + _timeframe + "\"," +
        "\"direction\":\"" + str.tostring(_deal_type) + "\"," +
        "\"signal\":\"" + _signal_type + "\"," +
        "\"open\":" + str.tostring(_open) + "," +
        "\"high\":" + str.tostring(_high) + "," +
        "\"low\":" + str.tostring(_low) + "," +
        "\"close\":" + str.tostring(_close) + "," +
        "\"volume\":" + str.tostring(_volume) + "," +
        "\"vwap\":" + str.tostring(_price) + "," +
        "\"candle_time\":\"" + candle_time_str + "\"" +
        "}" +
        "}"
    )

    alert(json_payload, alert.freq_once_per_bar_close)

 


//────────────────────
// ICHIMOKU CORE
//────────────────────
tenkan = getDonchian(tenkansen, close)
kijun  = getDonchian(kijunsen, close)
spanA  = getLeadLine1(tenkan, kijun)
spanB  = getDonchian(senko, close)


[o1,h1,l1,c1] = getOHLC("D", 1)
[o0, h0, l0, c0] = getOHLC("D", 0)


[pp, r1, s1, r2, s2, r3, s3] = calcPivot(o1,h1,l1,c1)

pp_tomorrow = (h0 + l0 + c0) / 3

adr = request.security(
    syminfo.tickerid,
    "D",
    ta.sma(high - low, 14)
)



//────────────────────
// PVSRA + VWAP DISPLACEMENT
//────────────────────

// === COLORS
greenVectorColor  = color.rgb(0, 156, 81)
redVectorColor    = color.rgb(114, 0, 0)

blueVectorColor   = color.rgb(0, 96, 175)
violetVectorColor = color.rgb(197, 70, 219)

bullColor         = color.rgb(140, 161, 142)
bearColor         = color.rgb(150, 119, 119)

//────────────────────
// BASE METRICS
//────────────────────

// Volume baseline
volMA = ta.sma(volume, volLen)

// Spread baseline
spread = high - low
spreadMA = ta.sma(spread, volLen)

// VWAP
hlcVwap = ta.vwap(hlc3)

// Distance from VWAP
vwapDistance =
     math.abs(close - hlcVwap)

// Average VWAP displacement
vwapDistanceMA =
     ta.sma(vwapDistance, volLen)

//────────────────────
// BULL / BEAR
//────────────────────
isBull = close > open
isBear = close < open

// A bullish engulfing candle is bullish and its real body fully covers the
// previous bearish real body. A bearish engulfing candle is the inverse.
bullishEngulfing =
     isBull and
     isBear[1] and
     open <= close[1] and
     close >= open[1]

bearishEngulfing =
     isBear and
     isBull[1] and
     open >= close[1] and
     close <= open[1]

//────────────────────
// VECTOR CONDITIONS
//────────────────────

// Strong volume
isClimaxVolume =
     volume >= volMA * climaxMul

// Medium volume
isAboveVolume =
     volume >= volMA * aboveMul

// Strong candle expansion
isSpreadExpansion =
     spread >= spreadMA * 1.5

// Strong displacement from value
isVwapExpansion =
     vwapDistance >= vwapDistanceMA * 1.5

//────────────────────
// FINAL VECTOR LOGIC
//────────────────────

// Strong vector
isClimax =
     isClimaxVolume and
     (isSpreadExpansion or isVwapExpansion)

// Medium vector
isAbove =
     not isClimax and
     isAboveVolume

//────────────────────
// PVSRA COLOR
//────────────────────
pvsraColor =(
     isClimax and isBull ? greenVectorColor :
     isClimax and isBear ? redVectorColor :

     isAbove and isBull  ? blueVectorColor :
     isAbove and isBear  ? violetVectorColor :

     isBull              ? bullColor :
     isBear              ? bearColor :
                            na)

//────────────────────
// APPLY COLORS
//────────────────────
engulfingColor =
     showEngulfing and bullishEngulfing ? engulfingBuyColor :
     showEngulfing and bearishEngulfing ? engulfingSellColor :
     pvsraColor

barcolor(engulfingColor)

// Available in TradingView's alert-condition menu.
alertcondition(bullishEngulfing, "Bullish Engulfing", "Bullish engulfing candle on {{ticker}} {{interval}}")
alertcondition(bearishEngulfing, "Bearish Engulfing", "Bearish engulfing candle on {{ticker}} {{interval}}")




